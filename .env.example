# MangoStack environment variables.
# Copy this file to `.env` and adjust the values to your setup.

# Host user/group IDs the containers will run as. On a Raspberry Pi default
# install both are usually 1000.
PUID=1000
PGID=1000

# IANA timezone, e.g. Europe/Madrid, UTC, America/New_York.
TZ=Europe/Madrid

# Filesystem layout on the host.
# Defaults assume an external USB drive mounted at /media/usb. Adjust freely
# if you keep your media elsewhere; nothing in the repo hard-codes these paths.
#   BASE_DIR    - root mount point, used by tango/reel as the storage root.
#   CONFIG_DIR  - per-service configuration directories live under here.
#   MEDIA_DIR   - the library tree exposed to media servers (Music, Manga, ...).
BASE_DIR=/media/usb
CONFIG_DIR=/media/usb/config
MEDIA_DIR=/media/usb/Storage

# --- Scarf (https://github.com/pixelotes/scarf) ---
# Password for the Scarf web UI.
SCARF_UI_PASSWORD=change-me
# Long random string used to sign Scarf's JWT tokens. Generate with:
#   openssl rand -hex 48
SCARF_JWT_SECRET=replace-with-a-long-random-string
# Optional: API key of an external Flexget instance to integrate with Scarf.
# Leave empty if you do not run Flexget.
SCARF_FLEXGET_API_KEY=
