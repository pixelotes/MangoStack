# MangoStack environment variables.
# Copy this file to `.env` and adjust the values to your setup.

# Host user/group IDs the containers will run as. On a Raspberry Pi default
# install both are usually 1000.
PUID=1000
PGID=1000

# IANA timezone, e.g. Europe/Madrid, UTC, America/New_York.
TZ=Europe/Madrid

# Where your media and downloads live on the host. Defaults assume an
# external USB drive mounted at /media/usb with the layout:
#   <BASE_DIR>             - storage root (downloads & completed media)
#   <BASE_DIR>/Completed   - finished media library, exposed as MEDIA_DIR
# Per-service config and runtime state stays inside the repo, in
# subdirectories like ./tango, ./reel, ./scarf, ...
BASE_DIR=/media/usb/Storage
MEDIA_DIR=/media/usb/Storage/Completed

# --- Scarf (https://github.com/pixelotes/scarf) ---
# Password for the Scarf web UI.
SCARF_UI_PASSWORD=change-me
# Long random string used to sign Scarf's JWT tokens. Generate with:
#   openssl rand -hex 48
SCARF_JWT_SECRET=replace-with-a-long-random-string
